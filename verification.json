{
  "mod_id": "soundtrackselector",
  "base_package": "com.glowingfederal.soundtrackselector",
  "display_name": "Soundtrack Selector",
  "archive_pattern": "{mod_id}-{full_version}+mc{mc}-{loader}.jar",
  "version_class": "{package_path}/BuildVersion.class",
  "required_classes": [
    "{package_path}/SoundtrackSelector.class",
    "{package_path}/ClientAdapter.class",
    "{package_path}/SelectorScreen.class"
  ],
  "required_shared_classes": [
    "{package_path}/domain/Track.class",
    "{package_path}/domain/Catalog.class",
    "{package_path}/domain/Preferences.class",
    "{package_path}/domain/OggDuration.class",
    "{package_path}/domain/SoundDefinitions.class",
    "{package_path}/domain/Library.class",
    "{package_path}/domain/ListView.class",
    "{package_path}/domain/FieldAccess.class",
    "{package_path}/domain/PlayerView.class"
  ],
  "class_roots": [
    "{package_path}/"
  ],
  "resource_roots": [
    "assets/{mod_id}/"
  ],
  "required_assets": [],
  "metadata_profiles": {
    "legacy": {
      "path": "mcmod.info",
      "json_values": {
        "0.modid": "{mod_id}",
        "0.name": "{display_name}",
        "0.version": "{full_version}",
        "0.mcversion": "{mc}"
      }
    },
    "forge": {
      "path": "META-INF/mods.toml",
      "sections": [
        {
          "table": "",
          "fields": {
            "modLoader": "javafml",
            "loaderVersion": "{fml_range}"
          }
        },
        {
          "table": "mods",
          "fields": {
            "modId": "{mod_id}",
            "version": "{full_version}",
            "displayName": "{display_name}",
            "displayTest": "IGNORE_ALL_VERSION"
          }
        },
        {
          "table": "dependencies.{mod_id}",
          "fields": {
            "modId": "{loader}",
            "versionRange": "{loader_range}",
            "mandatory": true,
            "side": "CLIENT"
          }
        },
        {
          "table": "dependencies.{mod_id}",
          "fields": {
            "modId": "minecraft",
            "versionRange": "[{mc}]",
            "mandatory": true,
            "side": "CLIENT"
          }
        }
      ]
    },
    "neoforge": {
      "path": "META-INF/neoforge.mods.toml",
      "sections": [
        {
          "table": "",
          "fields": {
            "modLoader": "javafml",
            "loaderVersion": "{fml_range}"
          }
        },
        {
          "table": "mods",
          "fields": {
            "modId": "{mod_id}",
            "version": "{full_version}",
            "displayName": "{display_name}"
          }
        },
        {
          "table": "dependencies.{mod_id}",
          "fields": {
            "modId": "{loader}",
            "versionRange": "{loader_range}",
            "type": "required",
            "side": "CLIENT"
          }
        },
        {
          "table": "dependencies.{mod_id}",
          "fields": {
            "modId": "minecraft",
            "versionRange": "[{mc}]",
            "type": "required",
            "side": "CLIENT"
          }
        }
      ]
    }
  },
